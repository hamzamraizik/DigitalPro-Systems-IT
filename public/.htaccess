DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep one canonical HTTPS host to prevent duplicate indexing.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.dps-it\.ma$ [NC]
  RewriteRule ^ https://www.dps-it.ma%{REQUEST_URI} [R=301,L]

  # Retired English paths permanently consolidate into the French URLs.
  RewriteRule ^about/?$ /a-propos/ [R=301,L,NC]
  RewriteRule ^projects/?$ /projets/ [R=301,L,NC]
  RewriteRule ^projects/(.+?)/?$ /projets/$1/ [R=301,L,NC]

  # The build emits a real index.html for every public route.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Unknown URLs must be genuine 404s, not indexable homepage copies.
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(?:css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:avif|gif|jpe?g|png|svg|webp)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "(?:\.html|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
