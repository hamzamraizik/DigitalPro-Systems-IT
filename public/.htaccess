<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep existing static assets and directories untouched.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # React Router owns every other URL. This makes direct visits and browser
  # refreshes on /services, /a-propos, /projets/*, etc. load the SPA.
  RewriteRule . /index.html [L]
</IfModule>
